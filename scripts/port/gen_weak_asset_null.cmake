# gen_weak_asset_null.cmake - emit a TU that defines every weak asset file
# symbol of assets/obseg/obseg.h as an absolute symbol at address 0.
#
# Why: obseg.h declares the ~760 asset file symbols (*Z models/setups/stans,
# L*E/L*J text banks, bg_*_seg) `extern u8 __attribute__((weak)) X[]` so an
# ELF/PE link with the asset objects dropped resolves them to NULL. ld64
# (Mach-O) does not resolve weak UNDEFINED references to NULL in a static
# link, so the Apple build (GE_COMPILED_ASSETS=OFF) defines them here, the
# same `.globl` + `.set` absolute-symbol pattern port/src/ucode_dl_stubs.c
# uses for ob__ob_end_seg. Never compiled when the asset objects are built.
#
# Usage: cmake -DSRC=<repo> -DOUT=<file.c> -P gen_weak_asset_null.cmake
if(NOT SRC OR NOT OUT)
    message(FATAL_ERROR "gen_weak_asset_null.cmake: pass -DSRC= and -DOUT=")
endif()

file(STRINGS "${SRC}/assets/obseg/obseg.h" lines REGEX "__attribute__\\(\\(weak\\)\\)")
set(names)
foreach(l IN LISTS lines)
    if(l MATCHES "__attribute__\\(\\(weak\\)\\)[ \t]+([A-Za-z_][A-Za-z0-9_]*)")
        list(APPEND names ${CMAKE_MATCH_1})
    endif()
endforeach()
list(REMOVE_DUPLICATES names)

# Symbols the port layer already defines: in its own top-level asm (e.g.
# ob__ob_end_seg in ucode_dl_stubs.c; defining it twice is a link error) or
# as a C array (asset_bin_stubs.c's `u8 bg_imp_all_p_seg[0x10000];` - an
# absolute 0 would silently replace that tentative definition).
file(GLOB port_srcs "${SRC}/port/src/*.c")
set(defined)
foreach(f IN LISTS port_srcs)
    file(STRINGS "${f}" globls REGEX "\\.globl \" ASM_SYM\\(\"[A-Za-z0-9_]+\"\\)")
    foreach(g IN LISTS globls)
        if(g MATCHES "ASM_SYM\\(\"([A-Za-z0-9_]+)\"\\)")
            list(APPEND defined ${CMAKE_MATCH_1})
        endif()
    endforeach()
    file(STRINGS "${f}" arrays REGEX "^u8[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]*\\[")
    foreach(a IN LISTS arrays)
        if(a MATCHES "^u8[ \t]+([A-Za-z_][A-Za-z0-9_]*)")
            list(APPEND defined ${CMAKE_MATCH_1})
        endif()
    endforeach()
endforeach()
if(defined)
    list(REMOVE_ITEM names ${defined})
endif()
list(LENGTH names count)

set(body "/* GENERATED by scripts/port/gen_weak_asset_null.cmake from\n")
string(APPEND body " * assets/obseg/obseg.h - do not edit. ${count} weak asset file symbols\n")
string(APPEND body " * defined as absolute 0 (NULL) for the Mach-O link; see the script. */\n")
string(APPEND body "#include \"asmsym.h\"\n\n__asm__(\n")
foreach(n IN LISTS names)
    string(APPEND body "    \"    .globl \" ASM_SYM(\"${n}\") \"\\n\"\n")
    string(APPEND body "    \"    .set \" ASM_SYM(\"${n}\") \", 0\\n\"\n")
endforeach()
string(APPEND body ");\n")

# Rewrite only on change so the TU does not recompile every build.
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL body)
    file(WRITE "${OUT}" "${body}")
endif()
