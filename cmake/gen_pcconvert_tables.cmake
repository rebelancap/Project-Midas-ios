# Imported from GoldenEye-Decomp-ios engine/cmake/gen_pcconvert_tables.cmake at
# 55a3a9c8 (donor HEAD), Phase 1 round 7a (docs/port-ios/11-round7a-pcconvert.md).
# Unchanged except the output dir (build/generated/). Midas's three inputs are
# the donor's: filelist.u.csv identical, file_resource_table.inc.c identical
# names (one comment/symbol differs), the same 512 modelFileHeader.inc.c.
# Included only when GE_HOST32=OFF.
#
# Generate port/pcconvert_tables.c — the committed metadata the three Python
# sidecar converters read, embedded into the binary so the C converter
# (port/src/pcconvert/) needs nothing but the user's ROM at runtime.
#
#   scripts/filelist.u.csv                 -> pcconvFileList  (rom addr + size)
#   assets/obseg/file_resource_table.inc.c -> pcconvTableNames (manifest order)
#   assets/**/modelFileHeader.inc.c        -> pcconvNsNt       (NS/NT per model)
#
# NOTE: filelist.u.csv is used for every region, exactly as the Python scripts
# do (they hard-code `scripts/filelist.u.csv` regardless of REGION — see
# docs/sidecar-converters.md §Audit note 1). Keeping the same wrong-for-PAL/JP
# input is deliberate: byte-identity with the Python is the acceptance test,
# and NTSC-U is the only supported region (D-006).

set(_PCV_OUT "${CMAKE_BINARY_DIR}/generated/pcconvert_tables.c")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated")

set(_PCV_BODY "/* Generated by cmake/gen_pcconvert_tables.cmake — do not edit. */\n")
string(APPEND _PCV_BODY "#include <stdint.h>\n")
string(APPEND _PCV_BODY "struct PcvFileRow { const char *base; uint32_t addr; uint32_t size; };\n")
string(APPEND _PCV_BODY "struct PcvNsNtRow { const char *name; uint16_t ns; uint16_t nt; };\n\n")

# ---------------------------------------------------------------- filelist ---
file(STRINGS "${CMAKE_SOURCE_DIR}/scripts/filelist.u.csv" _PCV_FL)
set(_PCV_ROWS "")
set(_PCV_NROWS 0)
foreach(_line IN LISTS _PCV_FL)
  string(REPLACE "," ";" _f "${_line}")
  list(LENGTH _f _n)
  if(_n LESS 3)
    continue()
  endif()
  list(GET _f 0 _addr)
  list(GET _f 1 _size)
  list(GET _f 2 _path)
  if(_path STREQUAL "")
    continue()
  endif()
  get_filename_component(_base "${_path}" NAME)
  string(REGEX REPLACE "\\.bin$" "" _base "${_base}")
  string(APPEND _PCV_ROWS "    { \"${_base}\", ${_addr}u, ${_size}u },\n")
  math(EXPR _PCV_NROWS "${_PCV_NROWS}+1")
endforeach()
string(APPEND _PCV_BODY "const struct PcvFileRow pcconvFileList[] = {\n${_PCV_ROWS}};\n")
string(APPEND _PCV_BODY "const int pcconvFileListCount = ${_PCV_NROWS};\n\n")

# ------------------------------------------------------------ table names ---
file(STRINGS "${CMAKE_SOURCE_DIR}/assets/obseg/file_resource_table.inc.c" _PCV_TL
     REGEX "\\{[ \t]*[A-Za-z0-9_]+[ \t]*,[ \t]*\"[^\"]+\"")
set(_PCV_NAMES "")
set(_PCV_NNAMES 0)
foreach(_line IN LISTS _PCV_TL)
  if(_line MATCHES "\\{[ \t]*[A-Za-z0-9_]+[ \t]*,[ \t]*\"([^\"]+)\"")
    string(APPEND _PCV_NAMES "    \"${CMAKE_MATCH_1}\",\n")
    math(EXPR _PCV_NNAMES "${_PCV_NNAMES}+1")
  endif()
endforeach()
string(APPEND _PCV_BODY "const char *const pcconvTableNames[] = {\n${_PCV_NAMES}};\n")
string(APPEND _PCV_BODY "const int pcconvTableNameCount = ${_PCV_NNAMES};\n\n")

# --------------------------------------------------------- NS/NT per model ---
file(GLOB_RECURSE _PCV_MFH "${CMAKE_SOURCE_DIR}/assets/*odelFileHeader.inc.c")
list(SORT _PCV_MFH)
set(_PCV_NSNT "")
set(_PCV_NNSNT 0)
foreach(_f IN LISTS _PCV_MFH)
  file(STRINGS "${_f}" _hl REGEX "MODELFILEHEADER\\(")
  foreach(_line IN LISTS _hl)
    if(NOT _line MATCHES "MODELFILEHEADER\\((.*)\\)[ \t]*;?[ \t]*$")
      continue()
    endif()
    string(REPLACE "," ";" _a "${CMAKE_MATCH_1}")
    list(LENGTH _a _n)
    if(_n LESS 9)
      continue()
    endif()
    list(GET _a 0 _nm)
    list(GET _a 4 _ns)
    list(GET _a 8 _nt)
    string(STRIP "${_nm}" _nm)
    string(STRIP "${_ns}" _ns)
    string(STRIP "${_nt}" _nt)
    # int(x, 0): decimal or 0x-hex only; anything else is skipped (ValueError)
    if(NOT _ns MATCHES "^(0[xX][0-9a-fA-F]+|[0-9]+)$")
      continue()
    endif()
    if(NOT _nt MATCHES "^(0[xX][0-9a-fA-F]+|[0-9]+)$")
      continue()
    endif()
    string(APPEND _PCV_NSNT "    { \"${_nm}\", ${_ns}, ${_nt} },\n")
    math(EXPR _PCV_NNSNT "${_PCV_NNSNT}+1")
  endforeach()
endforeach()
string(APPEND _PCV_BODY "const struct PcvNsNtRow pcconvNsNt[] = {\n${_PCV_NSNT}};\n")
string(APPEND _PCV_BODY "const int pcconvNsNtCount = ${_PCV_NNSNT};\n")

file(WRITE "${_PCV_OUT}" "${_PCV_BODY}")
message(STATUS "pcconvert tables: ${_PCV_NROWS} filelist rows, "
               "${_PCV_NNAMES} resource names, ${_PCV_NNSNT} model headers")
set(SRC_PCCONVERT_TABLES "${_PCV_OUT}")
